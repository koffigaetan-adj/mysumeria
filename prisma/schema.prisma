generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  pinHash        String
  // Longueur du code choisi à la création (6 ou 8 chiffres) : sert à afficher
  // le bon nombre de cases sur la page de connexion.
  pinLength      Int       @default(8)
  // Préférences d'alertes email (modifiables dans /parametres)
  notifyOnTransaction Boolean @default(true)  // mail
  pushOnTransaction   Boolean @default(true)  // notification push
  monthlyStatement    Boolean @default(true)  // mail (PDF)
  notifyOnLogin       Boolean @default(true)  // mail
  pushOnLogin         Boolean @default(true)  // notification push
  // Verrouillage anti brute-force : compteur d'échecs consécutifs + date de
  // fin de blocage temporaire (voir app/api/auth/login/route.ts).
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())

  passkeys          Passkey[]
  pushSubscriptions PushSubscription[]
}

// Clé WebAuthn (Face ID / empreinte / Windows Hello) enregistrée sur un appareil.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
}

// Abonnement aux notifications push d'un navigateur/téléphone.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

enum TransactionType {
  CREDIT
  DEBIT
}

model Transaction {
  id              String          @id @default(cuid())
  date            DateTime
  montant         Decimal         @db.Decimal(12, 2)
  type            TransactionType
  motif           String?
  // Personnalisation par l'utilisateur (Paramètres › clic sur une transaction)
  label           String?
  note            String?
  category        String?
  sourceEmailId   String          @unique
  rawEmailSnippet String
  createdAt       DateTime        @default(now())

  @@index([date])
}

// Une seule ligne (id = 1) : le point de départ du calcul de solde.
// solde courant = soldeInitial + crédits - débits (transactions >= soldeInitialDate)
model AccountConfig {
  id               Int      @id @default(1)
  soldeInitial     Decimal  @db.Decimal(12, 2)
  soldeInitialDate DateTime
  // Fin de validité de l'abonnement Gmail → Pub/Sub (détection instantanée), renouvelé par lib/sync.ts
  gmailWatchExpiration DateTime?
  updatedAt        DateTime @updatedAt
}

// Emails qui matchent le filtre expéditeur mais que parseBankEmail n'a pas su lire.
// On les garde pour debug / pour améliorer le parseur, au lieu de les perdre.
model UnparsedEmail {
  id            String   @id @default(cuid())
  sourceEmailId String   @unique
  fromAddress   String
  subject       String
  snippet       String
  body          String
  // Pourquoi l'email n'a pas donné de transaction : parseur en échec,
  // ou transaction reconnue mais sur un autre compte que BANK_ACCOUNT_NAME.
  reason        String?
  receivedAt    DateTime
  createdAt     DateTime @default(now())
}
