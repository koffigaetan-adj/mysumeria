# ============================================================
# Copie ce fichier en `.env` et remplis les valeurs.
# Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore).
# ============================================================

# --- Base de données Neon (Postgres) ---
# DATABASE_URL : la connection string "pooled" (avec -pooler dans le host)
# DIRECT_URL   : la connection string directe (sans -pooler), utilisée par les migrations Prisma
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Session (cookie JWT signé) ---
# Génère une valeur aléatoire longue, ex :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Google OAuth (API Gmail, lecture seule) ---
# Créés dans Google Cloud Console (voir README)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# En local : http://localhost:3000/api/gmail/callback
# En prod  : https://TON-APP.vercel.app/api/gmail/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# --- Refresh token Gmail ---
# Obtenu via la page /api/gmail/auth une fois connecté (voir README)
GMAIL_REFRESH_TOKEN=""

# --- Filtre des emails d'alerte bancaire ---
# L'adresse expéditrice des alertes de ta banque (Sumeria/Lydia)
BANK_ALERT_SENDER="no-reply@sumeria.eu"

# --- Filtre du sous-compte suivi ---
# Nom exact du sous-compte tel qu'il apparaît dans les emails (ex: « Compte courant Julienne »).
# Les transactions sur un autre compte (ex: le compte principal « Compte Courant »)
# sont ignorées (stockées dans UnparsedEmail avec un motif explicite) pour ne pas fausser le solde.
# Laisser vide pour ne filtrer sur aucun compte (déconseillé si plusieurs comptes envoient des alertes).
BANK_ACCOUNT_NAME="Compte courant Julienne"

# --- Vercel Cron ---
# Génère une valeur aléatoire (même méthode que SESSION_SECRET).
# Vercel l'envoie automatiquement dans le header Authorization du cron.
CRON_SECRET=""

# --- Notifications par email (Gmail SMTP) ---
# Compte Gmail qui ENVOIE les mails + "mot de passe d'application" Google (16 caractères,
# voir README). Secret distinct du refresh token OAuth (qui reste en lecture seule).
# Laisser vide désactive les notifications de mouvement ET le relevé mensuel.
# Les destinataires sont les utilisateurs eux-mêmes (Paramètres › Alertes dans l'app).
GMAIL_SMTP_USER="ton.compte@gmail.com"
GMAIL_APP_PASSWORD=""
# Optionnel : expéditeur affiché. Par défaut "Sumeria <GMAIL_SMTP_USER>". Une autre adresse
# ne fonctionne que si elle est déclarée en alias dans Gmail ("Envoyer des e-mails en tant que").
# NOTIFICATION_FROM="Sumeria <alertes@mon-alias.fr>"
